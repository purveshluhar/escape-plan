# Copy this file to .env (git-ignored) and edit it. Never commit .env.
# Never give a variable a VITE_ prefix: Vite ships those to the browser.
# `npm run server` reads .env. A variable set in the shell wins over .env.

# Which parser turns a typed sentence into an edit: "keywords" (plan C, no model) or "strands"
# (a local Strands Decider for op and target; see server/README.md). An unknown name stops the
# server at start. Empty or unset means keywords.
DECIDER=keywords

# DECIDER=strands only. Where `strands-decider serve` listens: http on 127.0.0.1 only, origin only.
# Any other URL stops the server at start. Empty or unset means http://127.0.0.1:8000.
# STRANDS_URL=http://127.0.0.1:8000
# How long one Strands call may take, in ms (1 to 60000). Empty or unset means 5000. A slower
# answer is dropped and the app shows "Did you mean".
# STRANDS_TIMEOUT_MS=5000

# Port on 127.0.0.1. Empty or unset means 8787.
SERVER_PORT=8787

# The server listens on 127.0.0.1 only. SERVER_HOST may be unset or 127.0.0.1; any other value
# (0.0.0.0, ::, a LAN address, localhost) stops the server at start.
# SERVER_HOST=127.0.0.1

# Cityweft block (tier 2 backdrop, data/README.md). Not read by the server: only
# `node --env-file=.env data/cityweft-fetch.ts` uses these. Put your key after the = sign.
CITYWEFT_API_KEY=
# Side of the fetched block in metres. Empty or unset means 500.
# CITYWEFT_SIZE_M=500
