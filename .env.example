# Copy this file to .env (git-ignored) and edit it. Never commit .env.
# Never give a variable a VITE_ prefix: Vite ships those to the browser.
# `npm run server` reads .env. A variable set in the shell wins over .env.

# Which parser turns a typed sentence into an edit. Only "keywords" (plan C) is built.
# An unknown name stops the server at start. Empty or unset means keywords.
DECIDER=keywords

# Port on 127.0.0.1. Empty or unset means 8787.
SERVER_PORT=8787

# The server listens on 127.0.0.1 only. SERVER_HOST may be unset or 127.0.0.1; any other value
# (0.0.0.0, ::, a LAN address, localhost) stops the server at start.
# SERVER_HOST=127.0.0.1
