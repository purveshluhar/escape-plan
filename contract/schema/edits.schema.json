{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edits.schema.json",
  "title": "Edit list",
  "description": "Contract 4.3. A JSON array of edits, applied in order.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/edit"
  },
  "$defs": {
    "edit": {
      "type": "object",
      "required": [
        "op",
        "target",
        "value",
        "source"
      ],
      "properties": {
        "op": {
          "enum": [
            "widen",
            "add_transfer_beam",
            "add_ramp",
            "close_door",
            "add_sleeve",
            "reset"
          ],
          "description": "add_sleeve is T2"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "enum": [
            "button",
            "text",
            "voice",
            "phone"
          ],
          "description": "text is T2; voice and phone are T3"
        }
      },
      "additionalProperties": false
    }
  }
}
